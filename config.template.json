# EPUB Translator Configuration Template
# Copy this to config.json and customize as needed

{
  "api_provider": "openai",
  "max_retries": 5,
  "retry_base_delay": 2,

  "openai": {
    "api_key": "",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o",
    "analysis_model": "gpt-4o-mini",
    "vision_model": "",
    "temperature": 0.3,
    "max_tokens": 16384
  },

  "anthropic": {
    "api_key": "",
    "base_url": "",
    "model": "claude-sonnet-4-6",
    "analysis_model": "claude-haiku-4-5",
    "vision_model": "",
    "temperature": 0.3,
    "max_tokens": 16384
  },

  "multimodal": {
    "enabled": false,
    "vision_model": "",
    "output_mode": "append",
    "max_image_mb": 2,
    "delay_between_requests": 1.0,
    "temperature": 0.2,
    "max_tokens": 4096
  },

  "translation": {
    "target_language": "zh",
    "target_language_name": "Simplified Chinese (简体中文)",
    "max_chunk_chars": 15000,
    "min_chunk_chars": 200,
    "skip_files_shorter_than": 50,
    "delay_between_requests": 1.0,
    "workers": 3,
    "glossary_max_terms_in_prompt": 150
  },

  "prompt_customization": {
    "translation_style": "literary",
    "formality": "moderate",
    "preserve_names": true,
    "cultural_adaptation": true
  },

  "pre_analysis": {
    "enabled": true,
    "chapter_sample_chars": 4000,
    "chapters_per_summary_batch": 4,
    "glossary_max_terms_total": 500,
    "incremental_glossary": true,
    "temperature": 0.2,
    "max_tokens": 4096
  },

  "processing": {
    "work_directory": "./epub_work",
    "keep_work_directory": false,
    "include_outside_spine": false
  }
}
